<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.MyPatternsPage"
             Title="Мои схемы"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" 
              HeightRequest="60" 
              Padding="10,0"
              BackgroundColor="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="&lt;"
                    BackgroundColor="Transparent"
                    TextColor="#2196F3"
                    FontSize="32"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    Clicked="OnBackClicked"/>

            <Label Grid.Column="1"
                   Text="Мои схемы"
                  
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <BoxView Grid.Column="2" WidthRequest="50" BackgroundColor="#1a1a1a"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <SearchBar Grid.Row="0"
                       x:Name="SearchBar" 
                       Placeholder="Поиск схем по названию"
                       MaxLength="50"
                       TextChanged="OnSearchTextChanged"
                       />

            <CollectionView Grid.Row="1"
                x:Name="PatternsCollection"
                SelectionMode="Single"
                SelectionChanged="OnPatternSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <ContentView Padding="10,5">
                            <Border Stroke="White"
                        StrokeThickness="1"
                     
                        StrokeShape="RoundRectangle 8">
                                <Grid Padding="10" 
                          ColumnDefinitions="100,*"
                          RowDefinitions="Auto,Auto">

                                    <Image Grid.Column="0"
                               Grid.RowSpan="2"
                               Source="{Binding ImagePath}"
                               HeightRequest="80"
                               WidthRequest="80"
                               Aspect="AspectFit"
                               VerticalOptions="Center"/>

                                    <Label Grid.Column="1"
                               Grid.Row="0"
                               Text="{Binding Name}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"/>
                                    <Label Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding Info}"
                               FontSize="12"
                               TextColor="Gray"
                               VerticalOptions="Start"
                               Margin="0,4,0,0"/>

                                </Grid>
                            </Border>
                        </ContentView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="EmptyLabel" 
                   Grid.Row="1"
                   Text="Нет сохраненных схем.&#10;Создайте первую схему!"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   FontSize="16"
                   TextColor="Gray"
                   IsVisible="False"/>
        </Grid>

    </Grid>
</ContentPage>