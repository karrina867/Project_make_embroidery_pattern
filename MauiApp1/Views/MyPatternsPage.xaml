<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.MyPatternsPage"
             Title="Мои схемы"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <SearchBar x:Name="SearchBar" 
                   Placeholder="Поиск схем..."
                   MaxLength="50"
                   TextChanged="OnSearchTextChanged"/>

        <CollectionView x:Name="PatternsCollection"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnPatternSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" 
                          ColumnDefinitions="100,*"
                          RowDefinitions="Auto,Auto">

                        <Image Grid.RowSpan="2"
                               Source="{Binding ImagePath}"
                               HeightRequest="80"
                               WidthRequest="80"
                               Aspect="AspectFit"/>

                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <Label Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding Info}"
                               FontSize="12"
                               TextColor="Gray"/>

                        <BoxView Grid.ColumnSpan="2"
                                 Grid.Row="2"
                                 HeightRequest="1"
                                 BackgroundColor="LightGray"
                                 Margin="0,5"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="EmptyLabel" 
               Grid.Row="1"
               Text="Нет сохраненных схем. &#10; Создайте схему!"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               HorizontalTextAlignment="Center"
               FontSize="16"
               TextColor="Gray"
               IsVisible="False"/>
    </Grid>
</ContentPage>