<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MauiApp1.Views.PatternViewerPage"
             Title="Просмотр схемы">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с информацией -->
        <VerticalStackLayout Padding="10" Spacing="5" BackgroundColor="#F0F0F0">
            <Label x:Name="PatternNameLabel" FontSize="18" FontAttributes="Bold"/>
            <Label x:Name="PatternInfoLabel" FontSize="12" TextColor="Gray"/>
        </VerticalStackLayout>

        <!-- Область для схемы -->
        <Grid Grid.Row="1">
            <skia:SKCanvasView x:Name="PatternCanvas"
                               PaintSurface="OnCanvasPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnCanvasTouch"/>

            <!-- Подсказка для пользователя -->
            <Label Text="👆 Два пальца для зума | ☝️ Один палец для перемещения"
                   FontSize="10"
                   TextColor="Gray"
                   BackgroundColor="White"
                   Opacity="0.7"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="0,0,0,10"
                   Padding="5"/>
        </Grid>

        <!-- Нижняя панель управления -->
        <HorizontalStackLayout Grid.Row="2" 
                               Padding="10" 
                               Spacing="10"
                               BackgroundColor="#F0F0F0">

            <Button Text="−" 
                    Clicked="OnZoomOutClicked"
                    BackgroundColor="#2196F3"
                    WidthRequest="60"
                    FontSize="24"
                    FontAttributes="Bold"
                    CornerRadius="5"/>

            <Label x:Name="ZoomLabel" 
                   Text="100%" 
                   HorizontalOptions="CenterAndExpand"
                   VerticalOptions="Center"
                   FontSize="16"
                   FontAttributes="Bold"/>

            <Button Text="+" 
                    Clicked="OnZoomInClicked"
                    BackgroundColor="#2196F3"
                    WidthRequest="60"
                    FontSize="24"
                    FontAttributes="Bold"
                    CornerRadius="5"/>

            <Button Text="⟳" 
                    Clicked="OnResetZoomClicked"
                    BackgroundColor="#FF9800"
                    WidthRequest="60"
                    FontSize="20"
                    CornerRadius="5"/>

            <Button Text="📋" 
                    Clicked="OnShowLegendClicked"
                    BackgroundColor="#4CAF50"
                    WidthRequest="60"
                    FontSize="20"
                    CornerRadius="5"/>

        </HorizontalStackLayout>
    </Grid>
</ContentPage>