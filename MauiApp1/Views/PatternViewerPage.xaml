<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MauiApp1.Views.PatternViewerPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" 
              HeightRequest="60" 
              Padding="10,0"
              BackgroundColor="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="&lt;"
                    BackgroundColor="Transparent"
                    TextColor="#2196F3"
                    FontSize="32"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    Clicked="OnBackClicked"/>

            <Label Grid.Column="1"
                   Text="Просмотр схемы"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <BoxView Grid.Column="2" WidthRequest="50" BackgroundColor="Transparent"/>
        </Grid>

        <Label Grid.Row="1"
               x:Name="PatternNameLabel"
               Text=""
               FontSize="16"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,10,0,5"/>

        <skia:SKCanvasView Grid.Row="2"
                           x:Name="PatternCanvas"
                           BackgroundColor="#1a1a1a"
                           PaintSurface="OnCanvasPaintSurface"
                           EnableTouchEvents="True"
                           Touch="OnCanvasTouch"/>

        <Grid Grid.Row="3" 
              BackgroundColor="#2a2a2a"
              RowDefinitions="Auto,Auto"
              Padding="10">

            <HorizontalStackLayout Grid.Row="0" 
                                   Spacing="10" 
                                   HorizontalOptions="Center"
                                   Margin="0,5">
                <Button x:Name="DmcButton"
                        Text="DMC"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="40"
                        CornerRadius="8"
                        Clicked="OnDmcClicked"/>
                <Button x:Name="GammaButton"
                        Text="Gamma"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="40"
                        CornerRadius="8"
                        Clicked="OnGammaClicked"/>
            </HorizontalStackLayout>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

                <Button Grid.Column="0"
                        Text="◀"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="50"
                        CornerRadius="8"
                        FontSize="16"
                        Clicked="OnScrollLeftClicked"/>

                <ScrollView x:Name="ColorsScrollView"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="5,0">
                    <HorizontalStackLayout x:Name="ColorsStackLayout"
                                           Spacing="10"
                                           Padding="5"/>
                </ScrollView>

                <Button Grid.Column="2"
                        Text="▶"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="50"
                        CornerRadius="8"
                        FontSize="16"
                        Clicked="OnScrollRightClicked"/>

            </Grid>

        </Grid>

    </Grid>
</ContentPage>