<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MauiApp1.Views.PatternProgressPage"
             Title="Вышивка"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" BackgroundColor="#2196F3" HeightRequest="60" Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="← Назад"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="16"
                    Clicked="OnBackClicked"/>

            <Label Grid.Column="1"
                   Text="Вышивка"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <Button Grid.Column="2"
                    Text="📊"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="20"
                    Clicked="OnStatsClicked"
                    WidthRequest="50"/>
        </Grid>

        <!-- Панель прогресса -->
        <VerticalStackLayout Grid.Row="1" Spacing="5" Padding="10" BackgroundColor="#F5F5F5">
            <Label x:Name="PatternNameLabel" FontSize="16" FontAttributes="Bold"/>
            <Label x:Name="ProgressLabel" FontSize="12" TextColor="Gray"/>
            <ProgressBar x:Name="ProgressBar" Progress="0" HeightRequest="10"/>
        </VerticalStackLayout>

        <!-- Область для схемы -->
        <skia:SKCanvasView Grid.Row="2"
                           x:Name="PatternCanvas"
                           PaintSurface="OnCanvasPaintSurface"
                           EnableTouchEvents="True"
                           Touch="OnCanvasTouch"/>

        <!-- Нижняя панель с элементами управления масштабом -->
        <HorizontalStackLayout Grid.Row="3" 
                               Padding="10" 
                               Spacing="10"
                               BackgroundColor="#F5F5F5"
                               HeightRequest="50">

            <Button Text="−" 
                    Clicked="OnZoomOutClicked"
                    BackgroundColor="#2196F3"
                    WidthRequest="50"
                    FontSize="20"
                    FontAttributes="Bold"
                    CornerRadius="5"/>

            <Label x:Name="ZoomLabel" 
                   Text="100%" 
                   HorizontalOptions="CenterAndExpand"
                   VerticalOptions="Center"
                   FontSize="14"
                   FontAttributes="Bold"/>

            <Button Text="+" 
                    Clicked="OnZoomInClicked"
                    BackgroundColor="#2196F3"
                    WidthRequest="50"
                    FontSize="20"
                    FontAttributes="Bold"
                    CornerRadius="5"/>

            <Button Text="⟳" 
                    Clicked="OnResetZoomClicked"
                    BackgroundColor="#FF9800"
                    WidthRequest="50"
                    FontSize="14"
                    CornerRadius="5"/>

        </HorizontalStackLayout>

    </Grid>
</ContentPage>