<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MauiApp1.Views.PatternProgressPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0"
              HeightRequest="60"
              Padding="10,0"
              BackgroundColor="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="&lt;"
                    BackgroundColor="Transparent"
                    TextColor="#2196F3"
                    FontSize="32"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    Clicked="OnBackClicked"/>

            <Button Grid.Column="1"
                    Text=""
                    BackgroundColor="Transparent"
                    WidthRequest="40"
                    IsEnabled="False"/>

            <Label Grid.Column="2"
                   Text="Вышивка"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <Button Grid.Column="3"
                    Text="Очистить"
                    BackgroundColor="#FF4444"
                    TextColor="White"
                    HeightRequest="35"
                    WidthRequest="90"
                    CornerRadius="8"
                    FontSize="13"
                    VerticalOptions="Center"
                    Clicked="OnClearProgressClicked"/>

        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="3" Padding="10,5" BackgroundColor="Transparent">
            <Label x:Name="PatternNameLabel"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
            <Label x:Name="ProgressLabel"
                   FontSize="12"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"/>
            <ProgressBar x:Name="ProgressBar"
                         Progress="0"
                         HeightRequest="6"
                         ProgressColor="#4CAF50"/>
        </VerticalStackLayout>

        <skia:SKCanvasView Grid.Row="2"
                           x:Name="PatternCanvas"
                           BackgroundColor="#1a1a1a"
                           PaintSurface="OnCanvasPaintSurface"
                           EnableTouchEvents="True"
                           Touch="OnCanvasTouch"/>

        <Grid Grid.Row="3"
              BackgroundColor="#2a2a2a"
              RowDefinitions="Auto,Auto,Auto"
              Padding="10">

            <HorizontalStackLayout Grid.Row="0"
                                   Spacing="10"
                                   HorizontalOptions="Center"
                                   Margin="0,5">
                <Button x:Name="DmcButton"
                        Text="DMC"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="40"
                        CornerRadius="8"
                        Clicked="OnDmcClicked"/>
                <Button x:Name="GammaButton"
                        Text="Gamma"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        WidthRequest="100"
                        HeightRequest="40"
                        CornerRadius="8"
                        Clicked="OnGammaClicked"/>
            </HorizontalStackLayout>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">

                <Button Grid.Column="0"
                        Text="◀"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="50"
                        CornerRadius="8"
                        FontSize="16"
                        Clicked="OnScrollLeftClicked"/>

                <ScrollView x:Name="ColorsScrollView"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            Margin="5,0">
                    <HorizontalStackLayout x:Name="ColorsStackLayout"
                                           Spacing="10"
                                           Padding="5"/>
                </ScrollView>

                <Button Grid.Column="2"
                        Text="▶"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        WidthRequest="40"
                        HeightRequest="50"
                        CornerRadius="8"
                        FontSize="16"
                        Clicked="OnScrollRightClicked"/>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>