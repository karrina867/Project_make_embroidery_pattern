<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.PatternDetailsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Верхняя панель -->
        <Grid Grid.Row="0"
              HeightRequest="60"
              Padding="10,0"
              BackgroundColor="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="&lt;"
                    BackgroundColor="Transparent"
                    TextColor="#2196F3"
                    FontSize="32"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    Clicked="OnBackClicked"/>

            <Label Grid.Column="1"
                   Text="Нитки"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <BoxView Grid.Column="2" WidthRequest="50" BackgroundColor="Transparent"/>
        </Grid>

        <!-- Информация о схеме -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="15,8"
                             Spacing="3"
                             BackgroundColor="Transparent">
            <Label x:Name="PatternNameLabel"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
            <Label x:Name="PatternSizeLabel"
                   TextColor="#AAAAAA"
                   FontSize="13"
                   HorizontalOptions="Center"/>
            <Label x:Name="PatternColorsLabel"
                   TextColor="#AAAAAA"
                   FontSize="13"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Список цветов -->
        <CollectionView x:Name="ColorsCollection"
                        Grid.Row="2"
                        SelectionMode="None"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8"
                          ColumnDefinitions="50,60,*,Auto">

                        <!-- Цветной квадрат -->
                        <Frame BackgroundColor="{Binding ColorHex}"
                               HeightRequest="42"
                               WidthRequest="42"
                               CornerRadius="6"
                               BorderColor="#444444"
                               HasShadow="False"
                               VerticalOptions="Center"/>

                        <!-- Символ -->
                        <Label Grid.Column="1"
                               Text="{Binding Symbol}"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="White"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

                        <!-- Коды ниток -->
                        <VerticalStackLayout Grid.Column="2"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="{Binding DMCNumber, StringFormat='DMC: {0}'}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Label Text="{Binding GammaNumber, StringFormat='Gamma: {0}'}"
                                   FontSize="12"
                                   TextColor="#AAAAAA"/>
                            <Label Text="{Binding ColorHex}"
                                   FontSize="11"
                                   TextColor="#666666"/>
                        </VerticalStackLayout>

                        <!-- Количество крестиков -->
                        <Label Grid.Column="3"
                               Text="{Binding PixelCount, StringFormat='{0} кр.'}"
                               FontSize="12"
                               TextColor="#AAAAAA"
                               VerticalOptions="Center"
                               Margin="0,0,4,0"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- Разделитель между элементами -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
            </CollectionView.ItemsLayout>
        </CollectionView>

    </Grid>
</ContentPage>
