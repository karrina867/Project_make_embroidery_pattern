<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.PatternDetailsPage"
             Title="Детали схемы"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Строки: 
             0 - панель навигации
             1 - информация о схеме
             2 - таблица цветов
             3 - кнопки действий
        -->

        <!-- Верхняя панель с кнопкой "Назад" - строка 0 -->
        <Grid Grid.Row="0" 
              BackgroundColor="#2196F3" 
              HeightRequest="60" 
              Padding="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="← Назад"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="16"
                    Clicked="OnBackClicked"/>

            <Label Grid.Column="1"
                   Text="Детали схемы"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>
        </Grid>

        <!-- Информация о схеме - строка 1 -->
        <VerticalStackLayout Grid.Row="1" 
                             Padding="10" 
                             Spacing="5"
                             BackgroundColor="#F5F5F5">
            <Label x:Name="PatternNameLabel" 
                   FontSize="20" 
                   FontAttributes="Bold"/>
            <Label x:Name="PatternSizeLabel" 
                   TextColor="Gray"
                   FontSize="14"/>
            <Label x:Name="PatternColorsLabel" 
                   TextColor="Gray"
                   FontSize="14"/>
        </VerticalStackLayout>

        <!-- Таблица цветов - строка 2 (занимает всё свободное место) -->
        <CollectionView x:Name="ColorsCollection" 
                        Grid.Row="2" 
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" 
                          ColumnDefinitions="50,100,*,*"
                          RowDefinitions="Auto">

                        <Frame BackgroundColor="{Binding ColorHex}" 
                               HeightRequest="40" 
                               WidthRequest="40"
                               CornerRadius="5"
                               BorderColor="Gray"
                               VerticalOptions="Center"/>

                        <Label Grid.Column="1" 
                               Text="{Binding Symbol}" 
                               FontSize="24"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="2" Spacing="2"
                                            VerticalOptions="Center">
                            <Label Text="{Binding ColorHex}" 
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding DMCNumber, StringFormat='DMC: {0}'}" 
                                   FontSize="11" 
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="3" 
                               Text="{Binding PixelCount, StringFormat='{0} крестиков'}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопки действий - строка 3 -->
        <HorizontalStackLayout Grid.Row="3" 
                               Padding="10" 
                               Spacing="10"
                               BackgroundColor="#F5F5F5"
                               HeightRequest="60">

            <Button Text="🖼️ PNG" 
                    Clicked="OnSavePngClicked"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Center"
                    CornerRadius="5"/>

            <Button Text="📋 TXT" 
                    Clicked="OnExportClicked"
                    BackgroundColor="#FF9800"
                    TextColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Center"
                    CornerRadius="5"/>

            <Button Text="🗑️ Удалить" 
                    Clicked="OnDeleteClicked"
                    BackgroundColor="#FF4444"
                    TextColor="White"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="Center"
                    CornerRadius="5"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>