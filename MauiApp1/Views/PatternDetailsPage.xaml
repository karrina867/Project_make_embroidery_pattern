<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.PatternDetailsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1a1a1a">

    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout Grid.Row="0" BackgroundColor="Transparent">

            <Grid HeightRequest="50" Padding="10,0" BackgroundColor="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Text="&lt;"
                        BackgroundColor="Transparent"
                        TextColor="#2196F3"
                        FontSize="32"
                        FontAttributes="Bold"
                        WidthRequest="50"
                        Clicked="OnBackClicked"/>

                <Label Grid.Column="1"
                       Text="Список ниток"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"/>

                <BoxView Grid.Column="2" WidthRequest="50" BackgroundColor="Transparent"/>
            </Grid>

            <Label x:Name="PatternNameLabel"
                   FontSize="15"
                   TextColor="#AAAAAA"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <BoxView HeightRequest="1" 
                     BackgroundColor="White" 
                     Opacity="0.8" 
                     HorizontalOptions="Fill"
                     Margin="0,0,0,0"/>
        </VerticalStackLayout>

        <CollectionView x:Name="ColorsCollection"
                        Grid.Row="1"
                        SelectionMode="None"
                        BackgroundColor="Transparent">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>

                        <Grid Padding="12,10"
                              ColumnDefinitions="50,60,*,Auto">

                            <Frame BackgroundColor="{Binding ColorHex}"
                                   HeightRequest="42"
                                   WidthRequest="42"
                                   CornerRadius="6"
                                   BorderColor="#444444"
                                   HasShadow="False"
                                   VerticalOptions="Center"/>

                            <Label Grid.Column="1"
                                   Text="{Binding Symbol}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding DMCNumber, StringFormat='DMC: {0}'}"
                                       FontSize="14"
                                       TextColor="White"/>
                                <Label Text="{Binding GammaNumber, StringFormat='Gamma: {0}'}"
                                       FontSize="14"
                                       TextColor="White"/>
                                <Label Text="{Binding ColorHex}"
                                       FontSize="11"
                                       TextColor="#666666"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="3"
                                   Text="{Binding PixelCount, StringFormat='{0} кр.'}"
                                   FontSize="12"
                                   TextColor="#AAAAAA"
                                   VerticalOptions="Center"
                                   Margin="0,0,4,0"/>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#333333"
                                 HorizontalOptions="Fill"
                                 Margin="12,0"/>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="0"/>
            </CollectionView.ItemsLayout>
        </CollectionView>

        <VerticalStackLayout Grid.Row="2"
                             BackgroundColor="Transparent">

            <BoxView HeightRequest="1" 
                     BackgroundColor="White" 
                     Opacity="0.8" 
                     HorizontalOptions="Fill"
                     Margin="0,0,0,0"/>

            <VerticalStackLayout Padding="15,12" Spacing="4">
                <Label x:Name="PatternSizeLabel"
                       TextColor="#AAAAAA"
                       FontSize="13"
                       HorizontalOptions="Center"/>
                <Label x:Name="PatternColorsLabel"
                       TextColor="#AAAAAA"
                       FontSize="13"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </VerticalStackLayout>

    </Grid>
</ContentPage>