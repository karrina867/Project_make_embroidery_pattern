<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.PatternDetailsPage"
             Title="Детали схемы">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Информация о схеме -->
        <VerticalStackLayout Padding="10" Spacing="5">
            <Label x:Name="PatternNameLabel" FontSize="20" FontAttributes="Bold"/>
            <Label x:Name="PatternSizeLabel" TextColor="Gray"/>
            <Label x:Name="PatternColorsLabel" TextColor="Gray"/>
        </VerticalStackLayout>

        <!-- Таблица цветов -->
        <CollectionView x:Name="ColorsCollection" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" ColumnDefinitions="50,100,*,*">
                        <Frame BackgroundColor="{Binding ColorHex}" 
                               HeightRequest="40" 
                               WidthRequest="40"
                               CornerRadius="5"
                               BorderColor="Gray"/>

                        <Label Grid.Column="1" 
                               Text="{Binding Symbol}" 
                               FontSize="24"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>

                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="{Binding ColorHex}" FontSize="12"/>
                            <Label Text="{Binding DMCNumber}" FontSize="12" TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="3" 
                               Text="{Binding PixelCount, StringFormat='{0} крестиков'}"
                               FontSize="12"
                               VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопки действий -->
        <HorizontalStackLayout Grid.Row="2" Padding="10" Spacing="10">
            <Button Text="📋 Экспорт" 
                    Clicked="OnExportClicked"
                    BackgroundColor="#4CAF50"
                    HorizontalOptions="FillAndExpand"/>

            <Button Text="🗑 Удалить" 
                    Clicked="OnDeleteClicked"
                    BackgroundColor="#FF4444"
                    HorizontalOptions="FillAndExpand"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>



