<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.CreatePatternPage"
             Title="Создание схемы"
             BackgroundColor="#1a1a1a"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" 
              HeightRequest="60" 
              Padding="10,0"
              BackgroundColor="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="&lt;"
                    BackgroundColor="Transparent"
                    TextColor="#2196F3"
                    FontSize="32"
                    FontAttributes="Bold"
                    WidthRequest="50"
                    Clicked="OnBackClicked"/>

            <Label Grid.Column="1"
                   Text="Создание схемы"
                  
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <BoxView Grid.Column="2" WidthRequest="50" BackgroundColor="Transparent"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">

                <Label Text="Название схемы" FontSize="16" FontAttributes="Bold"/>
                <Entry x:Name="PatternNameEntry" 
                       Placeholder="Введите название схемы"
                       MaxLength="50"/>

                <Label Text="Изображение" FontSize="16" FontAttributes="Bold"/>

                <Grid>
                    <Border BackgroundColor="Transparent"
                            Stroke="LightGray"
                            StrokeThickness="1.5"
                            Padding="10"
                            HeightRequest="220">
                        <Grid>
                            <Image x:Name="SelectedImage" 
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                            <Label x:Name="SelectImageLabel"
                                   Text="Выберите изображение"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="Gray"
                                   FontSize="16"
                                   IsVisible="True"/>
                        </Grid>
                    </Border>

                    <Button x:Name="SelectImageButton"
                            BackgroundColor="Transparent"
                            Clicked="OnSelectImageClicked"
                            HeightRequest="220"/>
                </Grid>

                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="KeepAspectCheckBox" 
                              IsChecked="True"
                              VerticalOptions="Center"/>
                    <Label Text="Сохранять пропорции изображения"
                           FontSize="14"
                           TextColor="Gray"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label Text="Размер схемы (количество крестиков)" FontSize="16" FontAttributes="Bold"/>

                <HorizontalStackLayout Spacing="10">
                    <Entry x:Name="WidthEntry" 
                           Placeholder="Ширина"
                           Keyboard="Numeric"
                           WidthRequest="150"
                           TextChanged="OnWidthChanged"/>
                    <Label Text="x" FontSize="18" VerticalOptions="Center"/>
                    <Entry x:Name="HeightEntry" 
                           Placeholder="Высота"
                           Keyboard="Numeric"
                           WidthRequest="150"
                           TextChanged="OnHeightChanged"/>
                </HorizontalStackLayout>

                <Button x:Name="SaveButton" 
                        Text="Сохранить схему" 
                        Clicked="OnSavePatternClicked"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        IsEnabled="False"
                        HeightRequest="50"
                        CornerRadius="8"/>

                <Label x:Name="MessageLabel" 
                       Text="" 
                       TextColor="Red"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>